{
  "name": "@u-b/lint-config",
  "version": "1.0.1",
  "description": "Shared oxlint and oxfmt configuration for TypeScript, React and Node projects",
  "keywords": [
    "lint-config",
    "oxc",
    "oxfmt",
    "oxlint",
    "react",
    "typescript"
  ],
  "homepage": "https://github.com/otrebu/uba-lint-config#readme",
  "bugs": {
    "url": "https://github.com/otrebu/uba-lint-config/issues"
  },
  "license": "MIT",
  "author": "Uberto Rapizzi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otrebu/uba-lint-config.git"
  },
  "files": [
    "AGENTS.md",
    "THIRD_PARTY_NOTICES",
    "index.js",
    "oxlint",
    "oxfmt",
    "types"
  ],
  "type": "module",
  "main": "index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./oxlint": {
      "types": "./types/oxlint/index.d.ts",
      "default": "./oxlint/index.js"
    },
    "./oxfmt": {
      "types": "./types/oxfmt/index.d.ts",
      "default": "./oxfmt/index.js"
    },
    "./oxlint-plugin": {
      "types": "./types/oxlint/plugin/index.d.ts",
      "default": "./oxlint/plugin/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "fix": "oxfmt && oxlint --disable-nested-config --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --disable-nested-config",
    "lint:fix": "oxlint --disable-nested-config --fix",
    "prepack": "rm -rf types && tsc -p tsconfig.types.json",
    "prepare": "husky",
    "test": "node --test 'test/**/*.test.js'"
  },
  "dependencies": {
    "@tanstack/eslint-plugin-query": "^5.91.4",
    "@tanstack/eslint-plugin-router": "^1.155.0",
    "eslint-plugin-cypress": "^5.3.0",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-testing-library": "7.16.2",
    "oxlint-plugin-eslint": "1.89.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.5",
    "@semantic-release/npm": "^13.1.4",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "husky": "^9.1.7",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "semantic-release": "^25.0.3",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "eslint-plugin-storybook": "^10.2.8",
    "oxfmt": ">=0.74.0 <1",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": ">=7.0.2004",
    "storybook": "^10.2.8"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-storybook": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    },
    "storybook": {
      "optional": true
    }
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "packageManager": "pnpm@10.6.5+sha512.cdf928fca20832cd59ec53826492b7dc25dc524d4370b6b4adbf65803d32efaa6c1c88147c0ae4e8d579a6c9eec715757b50d4fa35eea179d868eada4ed043af"
}
